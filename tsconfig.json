{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./",
		"module": "CommonJS",
		"target": "ES2020",
		"lib": ["ES2020"],
		"moduleResolution": "node",
		"sourceMap": true,
		"declaration": true,
		"skipLibCheck": true,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"credentials/**/*.ts",
		"nodes/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
